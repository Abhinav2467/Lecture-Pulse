# Copy to .env (repo root) and adjust.
PORT=4000
# Origin allowed by CORS in development (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
# SQLite file; relative paths resolve from the repo root.
DB_PATH=./data/pulse.db
# Secret mixed into the hash of every student clientId. Use a long random string.
SERVER_SALT=change-me-to-a-long-random-string
NODE_ENV=development
